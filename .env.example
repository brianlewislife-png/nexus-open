NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus?schema=public

# Redis (optional for queues/cache)
REDIS_URL=redis://localhost:6379

# API port
PORT=3001

# AI Provider API Keys (set your real keys only in your local .env)
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Ollama local server
OLLAMA_BASE_URL=http://localhost:11434

# NEXUS URLs
NEXUS_BASE_URL=http://localhost:3001
NEXUS_WEB_URL=http://localhost:3000

# Next.js public API URL (used by the web frontend in the browser)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: JWT secret for future auth
JWT_SECRET=

# Logging
LOG_LEVEL=info

# Social / official links (configure when available)
NEXUS_URL_GITHUB=
NEXUS_URL_WEBSITE=
NEXUS_URL_INSTAGRAM=
NEXUS_URL_TELEGRAM=
NEXUS_URL_WHATSAPP=

# Build-time social links for the web panel (NEXT_PUBLIC_ vars are inlined by Next.js)
NEXT_PUBLIC_NEXUS_URL_GITHUB=
NEXT_PUBLIC_NEXUS_URL_WEBSITE=
NEXT_PUBLIC_NEXUS_URL_INSTAGRAM=
NEXT_PUBLIC_NEXUS_URL_TELEGRAM=
NEXT_PUBLIC_NEXUS_URL_WHATSAPP=